rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/subscriptions/{id} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /users/{uid}/private/{document} {
      allow read: if owner(uid) && document in ['billing', 'preferences'];
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
